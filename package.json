{
  "name": "js-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "db:generate": "cd apps/database && npm run db:generate",
    "db:migrate": "cd apps/database && npm run db:migrate",
    "db:push": "cd apps/database && npm run db:push",
    "db:studio": "cd apps/database && npm run db:studio",
    "db:seed": "cd apps/database && npm run db:seed"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.0",
    "drizzle-kit": "^0.20.6",
    "prettier": "^3.1.1",
    "turbo": "^2.3.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
