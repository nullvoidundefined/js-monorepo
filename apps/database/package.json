{
  "name": "database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "echo 'Database setup - ready for migrations'",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.1",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "drizzle-kit": "^0.20.6",
    "eslint": "^8.56.0",
    "eslint-config-custom": "*",
    "jest": "^30.2.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

