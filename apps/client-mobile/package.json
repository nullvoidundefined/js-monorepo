{
  "name": "client-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:setup": "./scripts/setup-android.sh",
    "android:sha": "./scripts/get-android-sha.sh",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace ClientMobile.xcworkspace -scheme ClientMobile -configuration Release",
    "ios": "react-native run-ios --simulator=\"iPhone 16\"",
    "ios:device": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@packages/constant": "workspace:*",
    "@packages/hooks": "workspace:*",
    "@packages/type": "workspace:*",
    "@packages/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/cli": "latest",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@tanstack/react-query": "^5.90.16",
    "base-64": "^1.0.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-app-auth": "^7.2.0",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-screens": "^3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/gradle-plugin": "^0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/base-64": "^1.0.2",
    "@types/react": "^18.2.46",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "18.2.0"
  },
  "resolutions": {
    "react": "18.2.0"
  }
}
