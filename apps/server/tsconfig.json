{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@client-web/controllers/*": ["./src/controllers/*"],
      "@client-web/routes/*": ["./src/routes/*"],
      "@client-web/middleware/*": ["./src/middleware/*"],
      "@client-web/utils/*": ["./src/utils/*"],
      "database": ["../database/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
