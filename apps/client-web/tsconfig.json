{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@packages/type": ["../../packages/type/src/index.ts"],
      "@client-web/components/*": ["src/component/*"],
      "@client-web/constant/*": ["src/constant/*"],
      "@client-web/service/*": ["src/service/*"],
      "@client-web/style/*": ["./src/style/*"],
      "@client-web/hook/*": ["src/state/hook/*"],
      "@client-web/provider/*": ["src/state/provider/*"],
      "@client-web/utils/*": ["src/utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
